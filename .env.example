# Cross-device sync (optional). Copy to .env.local and fill in from
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
# Leave these empty to build a local-only reader: no Firebase code is loaded and nothing leaves the device.
# These values identify the project; they are not secrets. Access is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Development only: use the in-memory mock cloud instead of Firebase (node scripts/mock-cloud.mjs).
# VITE_SYNC_MOCK=http://localhost:4320
