rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own study state.
    match /users/{uid}/state/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.id is string
        && request.resource.data.kind in ['edit', 'hl', 'sec', 'chap', 'pref']
        && request.resource.data.st == request.time;
    }
    // Completed study sessions: written once, never changed.
    match /users/{uid}/studySessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.kind == 'ses'
        && request.resource.data.id == 'ses~' + sessionId
        && request.resource.data.st == request.time;
    }
    // The one active study timer (or the marker left when it stopped).
    match /users/{uid}/studyRuntime/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && docId == 'active'
        && request.resource.data.kind == 'run'
        && request.resource.data.st == request.time;
    }
    // Study goals (opt-in) and the personal study queue: small records merged field by field.
    match /users/{uid}/studyGoals/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && docId == 'default'
        && request.resource.data.kind == 'goal'
        && request.resource.data.st == request.time;
    }
    match /users/{uid}/studyQueue/{itemId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.kind == 'q'
        && request.resource.data.id == 'q~' + itemId
        && request.resource.data.st == request.time;
    }
    // The learner's own flags on a previous-year question. The questions themselves are static
    // content and are never uploaded.
    match /users/{uid}/pyqState/{pyqId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.kind == 'pyq'
        && request.resource.data.id == 'pyq~' + pyqId
        && request.resource.data.st == request.time;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
